# Trading Bot Configuration
# Copy this to .env and fill in values

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./tradingbot.db
# DATABASE_URL=postgresql://user:pass@localhost/tradingbot

# Strategy / simulation settings
STRATEGY_MODE=weather
SIMULATION_MODE=true
REAL_TRADING_ENABLED=false
INITIAL_BANKROLL=3
KELLY_FRACTION=0.25
DAILY_LOSS_LIMIT=1.50

# Weather strategy: tiny-bankroll paper defaults
WEATHER_ENABLED=true
WEATHER_POLYMARKET_ONLY=true
WEATHER_MIN_EDGE_THRESHOLD=0.10
WEATHER_MIN_ENTRY_PRICE=0.40
WEATHER_MAX_ENTRY_PRICE=0.60
WEATHER_MIN_TRADE_SIZE=0.50
WEATHER_MAX_TRADE_SIZE=0.50
WEATHER_MAX_TRADE_FRACTION=0.20
WEATHER_ALLOW_MIN_SIZE_ROUND_UP=true
WEATHER_MAX_OPEN_TRADES=4
WEATHER_MAX_ALLOCATION=3
WEATHER_TAKE_PROFIT_PRICE=0.75
WEATHER_STOP_LOSS_PRICE=0.35
WEATHER_EXIT_SLIPPAGE=0.01
WEATHER_CITIES=nyc,chicago,miami,los_angeles,denver

# Polymarket real trading (leave blank for paper mode)
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHECK_GEOBLOCK=true
POLYMARKET_MIN_ORDER_SIZE=5

# Kalshi API (RSA key auth for weather markets)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENABLED=false
FRED_API_KEY=
BLS_API_KEY=

# Mapbox token for map visualization (optional - demo token works)
VITE_MAPBOX_TOKEN=
